# Configuration of the docgen-mcp container. Copy to deploy/service.env and adjust.
# Every setting is described in src/docgen_service/config.py (prefix DOCGEN_).
# Secrets do not go here: the token is in deploy/stack.env (generate-secrets.sh). The
# agent's model endpoint is in the project's .env, which every job container receives;
# never put a setting of this file into .env.

# The agent image (docker compose build builds it as docgen-agent:latest).
DOCGEN_AGENT_IMAGE=docgen-agent:latest

# Jobs: agent containers at the same time, waiting jobs, time limit, retention.
DOCGEN_MAX_RUNNING_JOBS=3
DOCGEN_MAX_QUEUED_JOBS=20
DOCGEN_JOB_TIMEOUT_SECONDS=1500
DOCGEN_JOB_RETENTION_HOURS=24
# Resources of one job container (empty: no limit), for example 4g and 2.
DOCGEN_JOB_MEMORY_LIMIT=
DOCGEN_JOB_CPUS=

# Without which dependencies the service reports itself unavailable.
DOCGEN_REQUIRED_DEPENDENCIES=docker,image,gotenberg,model,agent_env

# Write the text of requests into the service's logs (off: only their length).
DOCGEN_LOG_REQUEST_TEXT=false
