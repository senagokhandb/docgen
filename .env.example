# ============================================================
# DOCGEN — model yapılandırması
# Bu dosyayı `.env` olarak kopyalayıp anahtarları doldurun:
#   cp .env.example .env
#
# Endpoint'ler OpenAI-uyumlu /v1 adresleridir ve tool calling
# desteklemelidir (Qwen Code her işi araç çağrısıyla yapar).
# ============================================================

# --- Ana model: agent'ı çalıştıran model (entrypoint.sh bunu kullanır) ---
# Qwen3.8-27B (vLLM), doğrudan endpoint — kimlik doğrulama yok
# (bağlam: 131072 token, tool calling: test edildi)
MODEL_ENDPOINT=http://45.145.22.79:8000/v1
MODEL_NAME=Qwen/Qwen3.8-27B-FP8
# API anahtarı (servis istemiyorsa boş bırakın)
MODEL_API_KEY=

# --- Gemma: LiteLLM proxy üzerinden (gemma-4-26b, LiteLLM adı: small_llm) ---
# Şu an entrypoint.sh tarafından kullanılmıyor (ikinci/yedek model için).
# Anahtar: LiteLLM'de oluşturulan, yalnızca small_llm'e yetkili sanal
# anahtar (master key DEĞİL). Ekipten isteyin; buraya yazmayın.
GEMMA_ENDPOINT=http://45.145.22.79:4000/v1
GEMMA_MODEL=small_llm
GEMMA_API_KEY=

# ------------------------------------------------------------
# Notlar:
# - LiteLLM master key .env'e YAZILMAZ: .env'deki her değer agent
#   konteynerine ortam değişkeni olarak geçer.
# - GOTENBERG_URL otomatik ayarlanır (compose iç ağı:
#   http://gotenberg:3000) — elle değiştirmeye gerek yok.
# ------------------------------------------------------------
