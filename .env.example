# ============================================================
# DOCGEN — model yapılandırması
# Bu dosyayı `.env` olarak kopyala ve kendi model
# endpoint'inizi + model adınızı yazın:
#   cp .env.example .env
#
# Endpoint OpenAI-uyumlu bir /v1 adresi olmalı
# (Gemma için kendi inference servisinizin adresi).
# ============================================================

# Model servisinizin OpenAI-uyumlu base URL'si
# Örnek: http://host-makineniz:8080/v1  veya  https://.../v1
MODEL_ENDPOINT=

# Model adı (endpoint'inizin bildiği ad)
# Örnek: gemma-3-27b-it
MODEL_NAME=

# API anahtarı (servis istemiyorsa boş bırakın)
MODEL_API_KEY=

# ------------------------------------------------------------
# Not: GOTENBERG_URL otomatik ayarlanır (compose iç ağı:
# http://gotenberg:3000) — elle değiştirmeye gerek yok.
# ------------------------------------------------------------
